        <div class="tactics-item"><strong>Tipo de Ataque:</strong> Precisión dinámica implacable y nervios de acero en el remate final.</div>
        <div class="tactics-item"><strong>Partida de Leyenda:</strong> Ding Liren vs. Gukesh D (Singapur, 2024). ¡La consagración del nuevo rey más joven de la historia!</div>
      </div>
              <div class="card-martina-story">
        <div class="martina-story-header"><span>💬 Anécdota con Martina:</span></div>
        <p>«Le pregunté a Gukesh si a los 18 años todavía le gustaba comer galletas antes de jugar. Me sonrió con timidez y me dijo: "Martina, la edad no importa si tu mente está tranquila y disfrutas cada jugada". Le mostré una clavada con mi alfil y me felicitó: "Tienes mirada de campeona"».</p>
      </div>
            </div>
          </div>

        </div>
      </article>

      <!-- ACCIÓN FUERA DE LA CARTA -->
      <div class="champion-card-action">
        <button class="btn-card-action is-upcoming" onclick="event.stopPropagation(); openBookModal('Gukesh D', '2024-Presente', 'El Prodigio de Singapur & Concentración de Diamante', 'Láminas para colorear del nuevo rey del ajedrez, cálculo prodigioso y la gran victoria en Singapur.')"><span>⏳ Libro en Producción · Ver Avance</span></button>
      </div>
    </div>

  </div><!-- /champions-grid -->

</div><!-- /campeones-container -->

<!-- MODAL PREVIEW DE LIBROS DE ACTIVIDADES -->
<div class="champion-modal" id="champion-modal" onclick="closeBookModal(event)">
  <div class="modal-content" onclick="event.stopPropagation()">
    <button class="modal-close-btn" onclick="closeBookModalDirect()" aria-label="Cerrar modal">✕</button>
    <div id="modal-body">
      <!-- Dynamic content injected by JS -->
    </div>
  </div>
</div>

<script>
  // Flip card toggle
  function toggleCardFlip(card) {
    if (!card) return;
    card.classList.toggle('is-flipped');
  }

  function handleCardKeydown(card, event) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      toggleCardFlip(card);
    }
  }

  // Filter Era functionality
  function filterEra(era, btn) {
    const items = document.querySelectorAll('.champion-item');
    const buttons = document.querySelectorAll('.filter-btn');

    buttons.forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    items.forEach(item => {
      if (era === 'all' || item.getAttribute('data-era') === era) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  // Modal Functionality
  function openBookModal(name, years, theme, description) {
    const modal = document.getElementById('champion-modal');
    const modalBody = document.getElementById('modal-body');

    modalBody.innerHTML = `
      <div style="text-align: center; margin-bottom: 1.5rem;">
        <span style="font-size: 2.2rem;">👑</span>
        <h2 style="font-size: 1.8rem; margin: 0.3rem 0; color: var(--heading-color);">Libro de Aventuras & Colorear</h2>
        <h3 style="font-size: 1.25rem; color: var(--rose); margin-bottom: 0.2rem;">${name} (${years})</h3>
        <p style="font-size: 0.9rem; font-weight: bold; color: var(--magic-blue); text-transform: uppercase; letter-spacing: 0.5px;">${theme}</p>
      </div>
      <div style="background: var(--paper); border: 2px dashed var(--gold); border-radius: 12px; padding: 1.2rem; margin-bottom: 1.5rem;">
        <p style="font-size: 0.95rem; line-height: 1.6; margin: 0; color: var(--text-color);">
          ${description}
        </p>
      </div>
      <div style="font-size: 0.9rem; margin-bottom: 1.5rem;">
        <h4 style="margin-bottom: 0.6rem; color: var(--heading-color);">🎨 Contenido de la Colección:</h4>
        <ul style="padding-left: 1.2rem; line-height: 1.6; color: var(--text-color);">
          <li><strong>Formato Carta (Letter):</strong> 100% en blanco y negro (line art puro) para imprimir y pintar con lápices.</li>
          <li><strong>Orlas y Marcos Históricos:</strong> Diseño editorial personalizado a la época del campeón.</li>
          <li><strong>Retos y Laberintos:</strong> Sopas de letras temáticas, laberintos de caballos y problemas tácticos de sus partidas reales.</li>
          <li><strong>Diploma de Honor:</strong> Certificado de Gran Maestra para enmarcar.</li>
        </ul>
      </div>
      <div style="text-align: center;">
        ${(() => {
          let pdfUrl = '';
          let pdfName = '';
          if (name.includes('Capablanca')) {
            pdfUrl = '/assets/pdf/capablanca_libro_colorear.pdf';
            pdfName = 'Libro_Aventuras_Ajedrez_Capablanca.pdf';
          } else if (name.includes('Steinitz')) {
            pdfUrl = '/assets/pdf/steinitz_libro_colorear.pdf';
            pdfName = 'Libro_Aventuras_Ajedrez_Steinitz.pdf';
          } else if (name.includes('Lasker')) {
            pdfUrl = '/assets/pdf/lasker_libro_colorear.pdf';
            pdfName = 'Libro_Aventuras_Ajedrez_Lasker.pdf';
          } else if (name.includes('Alekhine')) {
            pdfUrl = '/assets/pdf/alekhine_libro_colorear.pdf';
            pdfName = 'Libro_Aventuras_Ajedrez_Alekhine.pdf';
          } else if (name.includes('Euwe')) {
            pdfUrl = '/assets/pdf/euwe_libro_colorear.pdf';
            pdfName = 'Libro_Aventuras_Ajedrez_Euwe.pdf';
          }

          if (pdfUrl) {
            return `
              <div style="background: rgba(46, 139, 87, 0.1); border: 1.5px solid var(--forest); border-radius: 8px; padding: 0.8rem; margin-bottom: 1rem;">
                <p style="margin: 0; font-size: 0.9rem; color: var(--forest); font-weight: bold;">
                  🎉 ¡Libro oficial de ${name} 100% completo y listo para imprimir en tamaño Carta!
                </p>
              </div>
              <a href="${pdfUrl}" download="${pdfName}" class="btn-download-book" style="display: inline-flex;">
                ⬇️ Descargar Libro Completo de ${name} (PDF)
              </a>
            `;
          } else {
            return `
              <div style="background: rgba(244, 162, 97, 0.12); border: 1.5px solid var(--gold); border-radius: 10px; padding: 0.9rem; margin-bottom: 1rem; text-align: left;">
                <p style="margin: 0 0 0.35rem; font-size: 0.92rem; color: var(--heading-color); font-weight: 800;">
                  ⏳ Libro de Aventuras de ${name} en producción
                </p>
                <p style="margin: 0; font-size: 0.85rem; color: var(--text-color); line-height: 1.5;">
                  Estamos preparando e ilustrando las láminas y retos didácticos de <strong>${name}</strong> para mantener el mismo estándar de alta calidad en tamaño Carta.
                </p>
              </div>
              <p style="margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--muted-color); font-weight: 600;">
                Muestras oficiales ya terminadas disponibles para descargar:
              </p>
              <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
                <a href="/assets/pdf/capablanca_libro_colorear.pdf" download="Libro_Aventuras_Ajedrez_Capablanca.pdf" class="btn-sample-download">
                  📄 Libro de Capablanca
                </a>
                <a href="/assets/pdf/steinitz_libro_colorear.pdf" download="Libro_Aventuras_Ajedrez_Steinitz.pdf" class="btn-sample-download">
                  📄 Libro de Steinitz
                </a>
                <a href="/assets/pdf/lasker_libro_colorear.pdf" download="Libro_Aventuras_Ajedrez_Lasker.pdf" class="btn-sample-download">
                  📄 Libro de Lasker
                </a>
                <a href="/assets/pdf/alekhine_libro_colorear.pdf" download="Libro_Aventuras_Ajedrez_Alekhine.pdf" class="btn-sample-download">
                  📄 Libro de Alekhine
                </a>
                <a href="/assets/pdf/euwe_libro_colorear.pdf" download="Libro_Aventuras_Ajedrez_Euwe.pdf" class="btn-sample-download">
                  📄 Libro de Euwe
                </a>
              </div>
            `;
          }
        })()}
      </div>
    `;

    modal.classList.add('active');
  }

  function closeBookModal(e) {
    if (e.target.id === 'champion-modal') {
      document.getElementById('champion-modal').classList.remove('active');
    }
  }

  function closeBookModalDirect() {
    document.getElementById('champion-modal').classList.remove('active');
  }
</script>