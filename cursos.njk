<!-- Script de Búsqueda y Filtrado Instantáneo -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('course-search-input');
    const catButtons = document.querySelectorAll('.cat-pill-btn');
    const items = document.querySelectorAll('.course-item-card');
    const noMsg = document.getElementById('no-courses-msg');

    let currentCat = 'all';
    let currentSearch = '';

    function filterCourses() {
      let visibleCount = 0;
      const query = currentSearch.toLowerCase().trim();

      items.forEach(item => {
        const category = item.getAttribute('data-category');
        const searchData = (item.getAttribute('data-search') + ' ' + item.innerText).toLowerCase();

        const matchesCat = (currentCat === 'all' || category === currentCat);
        const matchesSearch = (!query || searchData.includes(query));

        if (matchesCat && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        noMsg.style.display = 'block';
      } else {
        noMsg.style.display = 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentSearch = e.target.value;
        filterCourses();
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        catButtons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentCat = this.getAttribute('data-cat');
        filterCourses();
      });
    });
  });
</script>
