<script>
  const availableImages = [
    "/assets/img/super_martina_juego_1780024581060.png",
    "/assets/img/martina_peoncito_estudio_1779035328084.png",
    "/assets/img/mundo_magico_1778904597376.png",
    "/assets/img/martina_ines_torneo_1779139889385.png",
    "/assets/img/relampago_vikingo_blitz_1779112516290.png",
    "/assets/img/martina_pablo_tramposo_1779113476167.png"
  ];

  let selectedStyle = "premium";
  let selectedImg = "/assets/img/tarjeta_promocional_premium.png";

  function setDesign(el) {
    document.querySelectorAll('.design-option').forEach(opt => opt.classList.remove('active'));
    el.classList.add('active');

    selectedStyle = el.getAttribute('data-style');
    selectedImg = el.getAttribute('data-img');

    const mockupCard = document.getElementById('mockup-card');
    const mockupImg = document.getElementById('mockup-img');

    if (selectedStyle === 'premium') {
      mockupCard.classList.add('is-premium');
      mockupImg.src = "/assets/img/tarjeta_promocional_premium.png";
    } else {
      mockupCard.classList.remove('is-premium');
      if (selectedStyle === 'mix') {
        mockupImg.src = "/assets/img/martina_profile_1778904530237.png";
      } else {
        mockupImg.src = selectedImg;
      }
    }

    renderPrintGrid();
  }

  function renderPrintGrid() {
    const printGrid = document.getElementById('print-grid');
    printGrid.innerHTML = '';

    for (let i = 0; i < 6; i++) {
      const cardBox = document.createElement('div');
      
      if (selectedStyle === 'premium') {
        cardBox.className = 'print-card-box no-border';
        cardBox.innerHTML = `
          <img class="full-card-img" src="/assets/img/tarjeta_promocional_premium.png" alt="Tarjeta Premium">
        `;
      } else {
        cardBox.className = 'print-card-box';
        let cardImg = selectedImg;
        if (selectedStyle === 'mix') {
          cardImg = availableImages[i % availableImages.length];
        }
        
        cardBox.innerHTML = `
          <div class="chess-card">
            <div class="card-header-banner">
              <img src="${cardImg}" alt="Portada">
            </div>
            <div class="card-content-area">
              <div>
                <h3 class="card-title-text" style="font-size: 0.95rem;">Martina · Ajedrez</h3>
                <p class="card-promo-desc" style="font-size: 0.65rem; margin-bottom: 0.2rem;">¡Cuentos para dormir, bots y juegos interactivos gratis!</p>
              </div>
              <div class="card-bottom-row" style="padding: 0.25rem;">
                <div class="card-qr-wrapper" style="width: 50px; height: 50px; padding: 2px;">
                  <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=https%3A%2F%2Fmartinachess.com&color=012a4a" alt="QR">
                </div>
                <div class="card-footer-info">
                  <span style="font-size: 0.65rem;">Escanea el QR</span>
                  <small style="font-size: 0.5rem;">Cuentos, bots y juegos</small>
                  <small style="font-size: 0.5rem; font-weight:bold; color:#f4a261;">martinachess.com</small>
                </div>
              </div>
            </div>
          </div>
        `;
      }
      printGrid.appendChild(cardBox);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderPrintGrid();

    const container = document.getElementById('card-wrapper');
    const card = document.getElementById('mockup-card');

    if (container && card) {
      container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        const x = e.clientX - rect.left - (rect.width / 2);
        const y = e.clientY - rect.top - (rect.height / 2);
        
        const rotateX = -(y / rect.height) * 30;
        const rotateY = (x / rect.width) * 30;
        
        card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      });

      container.addEventListener('mouseleave', () => {
        card.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
      });
    }
  });
</script>
