              <span></span><span></span><span></span>
            </span>
            <span id="audio-btn-label">Escuchar</span>
          </button>
        </div>
      </header>

      <!-- Globo de Habla del Alfil Exiliado -->
      <div class="speech-bubble">
        <span class="story-number" id="course-kicker" style="display: inline-block; margin-bottom: 0.5rem;">Módulo 1</span>
