          <img src="/assets/img/alfil_exiliado_1778944848314.png" alt="Alfil Exiliado" class="character-avatar">
          <span class="character-badge-icon" title="Instructor">♗</span>
        </div>
        <div class="character-info">
          <h3>Alfil Exiliado</h3>
