<!-- Layout del Curso (Columna Izquierda: Encabezado + Módulos + Narración | Columna Derecha: Tablero + Controles) -->
<main class="course-main-layout fade-in">
  
  <!-- Columna Izquierda -->
  <section class="course-narrative-col">
    
    <!-- Cabecera y Breadcrumb -->
    <header class="course-app-header">
      <div class="course-breadcrumb">
        <a href="/">Inicio</a> / <a href="/cursos.html">Cursos</a> / <span>El Sistema Colle</span>
      </div>
      <div class="course-app-title-bar">
        <h1>📐 El Sistema Colle</h1>
      </div>
    </header>

    <!-- Barra de Progreso y Selección de Módulos -->
    <section class="course-stepper-wrap">
